# Configuración de Variables de Entorno - Curso LangChain & LangGraph
# Copia este archivo y renómbralo a '.env'. 
# Luego, sustituye 'TU_API_KEY_AQUÍ' con tus claves reales.

# Requerido para el proyecto de Evaluación de CVs
OPENAI_API_KEY=TU_API_KEY_DE_OPENAI_AQUÍ

# Requerido para proyectos que usen modelos de Google (opcional)
GOOGLE_API_KEY=TU_API_KEY_DE_GOOGLE_AQUÍ

# Recomendado para depuración de cadenas en LangSmith
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=TU_API_KEY_DE_LANGSMITH_AQUÍ
LANGCHAIN_PROJECT=curso-langchain-langgraph
